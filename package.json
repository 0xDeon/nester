{
  "name": "nester",
  "private": true,
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "website": "turbo run dev --filter=@nester/website",
    "dapp": "turbo run dev --filter=@nester/dapp"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "protobufjs@<7.5.5": ">=7.5.5",
      "shell-quote@<1.11.0": ">=1.11.0",
      "tar@<7.5.19": ">=7.5.19",
      "next-auth@<4.24.15": ">=4.24.15",
      "dompurify@<3.4.17": ">=3.4.17"
    }
  }
}
